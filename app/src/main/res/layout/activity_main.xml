<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Tela 1: Grade de Seleção de Inteligência Artificial -->
    <ScrollView
        android:id="@+id/scroll_ai"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="36dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/panel_ai_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Título discreto minimalista no topo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="AI ASSISTANTS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <!-- Fileira 1: Gemini & ChatGPT -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Gemini Card -->
                <FrameLayout
                    android:id="@+id/btn_gemini"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_social_tile_selector"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_gemini"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Gemini"
                            android:textColor="#E2E8F0"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ChatGPT Card -->
                <FrameLayout
                    android:id="@+id/btn_chatgpt"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_social_tile_selector"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_chatgpt"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ChatGPT"
                            android:textColor="#E2E8F0"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

            <!-- Fileira 2: Perplexity AI -->
            <FrameLayout
                android:id="@+id/btn_perplexity"
                android:layout_width="148dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_social_tile_selector"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_perplexity"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perplexity AI"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Tela 2: Navegador GeckoView com Container Quadrado (Square) ou Fullscreen Responsivo -->
    <FrameLayout
        android:id="@+id/browser_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- Área onde o GeckoView fica posicionado (centralizado e protegido contra cortes circulares) -->
        <FrameLayout
            android:id="@+id/gecko_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#000000">

            <org.mozilla.geckoview.GeckoView
                android:id="@+id/geckoview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Barra de Progresso de Carregamento Superior Sutil -->
        <ProgressBar
            android:id="@+id/progress_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:max="100"
            android:visibility="gone" />

        <!-- Indicador de Zoom Discreto Flutuante (Center Top) temporário ao usar rotary -->
        <TextView
            android:id="@+id/txt_zoom_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_zoom_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Painel Inferior Completo (Bottom Sheet Dock): Invocado suavemente ao arrastar de baixo para cima -->
        <LinearLayout
            android:id="@+id/bottom_controls_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_sheet"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <!-- Pílula/Handle Superior Indicadora de Bottom Sheet -->
            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_sheet_handle" />

            <!-- Linha de Ações dentro do Dock -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Botão Voltar "‹ IAs" -->
                <FrameLayout
                    android:id="@+id/btn_back_home"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_bottom_btn_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/txt_back_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="‹ IAs"
                        android:textColor="#F1F5F9"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Divisor Vertical Sutil -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#475569" />

                <!-- Botão Alternar Quadrado/Redondo ("◯" / "▢") -->
                <FrameLayout
                    android:id="@+id/btn_toggle_aspect"
                    android:layout_width="38dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_bottom_btn_selector"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txt_aspect_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="◯"
                        android:textColor="#38BDF8"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
